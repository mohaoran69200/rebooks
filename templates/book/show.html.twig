{% extends 'base.html.twig' %}

{% block title %}{{ book.title }}{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-10">
        <div class="max-w-3xl mx-auto bg-white shadow-xl rounded-xl p-8 flex flex-col gap-6">
            <h1 class="text-4xl font-extrabold text-gray-900">{{ book.title }}</h1>

            <div class="w-full flex justify-center">
                <div class="w-48 h-72 overflow-hidden rounded-xl shadow-lg">
                    <img src="{{ asset('uploads/book_covers/' ~ book.imageName) }}"
                         alt="Image de couverture"
                         class="w-full h-full object-cover object-center">
                </div>
            </div>


            <p class="text-gray-700 text-lg"><span class="font-semibold">Auteur :</span> {{ book.authorName }}</p>
            <p class="text-gray-600 leading-relaxed">{{ book.description }}</p>
            <p class="text-xl font-bold text-green-800">Prix : {{ book.price }} €</p>
            <p class="text-sm text-gray-500">Catégorie : {{ book.category.name }}</p>

            <div class="flex flex-wrap gap-4 mt-6">
                <a href="{{ path('book_list') }}"
                   class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition">
                    Retour à la liste
                </a>

                {% if app.user and app.user == book.user %}
                    <a href="{{ path('book_edit', {'id': book.id}) }}"
                       class="bg-yellow-500 text-white px-4 py-2 rounded-lg hover:bg-yellow-600 transition">
                        Modifier
                    </a>

                    <form action="{{ path('book_remove', {'id': book.id}) }}" method="POST">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
                        <button type="submit"
                                class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition">
                            Supprimer
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
