{% extends 'base.html.twig' %}

{% block title %}Liste des Livres{% endblock %}

{% block body %}
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-center my-6">Liste des Livres</h1>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {% for book in books %}
                <div class="bg-white shadow-lg rounded-lg p-4 flex flex-col justify-between">
                    <div>
                        <h2 class="text-xl font-semibold">{{ book.title }}</h2>
                        <p class="text-gray-600 mt-2"><strong>Auteur :</strong> {{ book.authorName }}</p>
                        <p class="text-gray-700 font-bold mt-2">{{ book.price }} €</p>
                    </div>
                    <a href="{{ path('book_show', { id: book.id }) }}"
                       class="mt-4 inline-block bg-blue-500 text-white px-4 py-2 rounded-lg text-center
                       hover:bg-blue-600 transition">
                        Voir plus
                    </a>
                </div>
            {% else %}
                <p class="col-span-4 text-center text-gray-500">Aucun livre trouvé.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
