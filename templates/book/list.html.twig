{% extends 'base.html.twig' %}

{% block title %}Liste des Livres{% endblock %}

{% block body %}
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-center my-6">Liste des Livres</h1>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {% for book in books %}
                {% include '_partials/_cardBook.html.twig' with {'book': book} %}
            {% else %}
                <p class="col-span-4 text-center text-gray-500">Aucun livre trouvé.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
