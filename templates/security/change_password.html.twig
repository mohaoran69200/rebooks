{% extends 'base.html.twig' %}

{% block title %}Changer le mot de passe{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'dropdown', 'password']) }}
{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-gray-100">
        <div class="bg-white shadow-lg rounded-lg p-8 w-full max-w-md">

            <h1 class="text-xl font-bold text-center text-gray-800 mb-6">Modifier votre mot de passe</h1>

            <!-- Messages flash -->
            {% for flashMessage in app.flashes('success') %}
                <div class="mb-4 text-green-700 bg-green-100 p-3 rounded-lg">
                    {{ flashMessage }}
                </div>
            {% endfor %}

            {% for flashMessage in app.flashes('error') %}
                <div class="mb-4 text-red-700 bg-red-100 p-3 rounded-lg">
                    {{ flashMessage }}
                </div>
            {% endfor %}

            <!-- Formulaire -->
            {{ form_start(changePasswordForm, {'attr': {'class': 'space-y-4'}}) }}

            <!-- Ancien mot de passe -->
            <div class="relative">
                {{ form_label(changePasswordForm.oldPassword, 'Ancien mot de passe', {'label_attr': {'class': 'block text-gray-700 font-semibold'}}) }}
                {{ form_widget(changePasswordForm.oldPassword, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-400'}}) }}

                <!-- Icône pour afficher/masquer -->
                <button type="button" class="absolute right-3 top-9 text-gray-500 hover:text-gray-700 toggle-password">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 eye-icon" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 4.5c-7.333 0-11 7.5-11 7.5s3.667 7.5 11 7.5 11-7.5 11-7.5-3.667-7.5-11-7.5z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                </button>
            </div>

            <!-- Nouveau mot de passe -->
            <div class="relative">
                {{ form_label(changePasswordForm.newPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'block text-gray-700 font-semibold'}}) }}
                {{ form_widget(changePasswordForm.newPassword.first, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-400'}}) }}

                <button type="button" class="absolute right-3 top-9 text-gray-500 hover:text-gray-700 toggle-password">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 eye-icon" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 4.5c-7.333 0-11 7.5-11 7.5s3.667 7.5 11 7.5 11-7.5 11-7.5-3.667-7.5-11-7.5z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                </button>
            </div>

            <!-- Confirmation du mot de passe -->
            <div class="relative">
                {{ form_label(changePasswordForm.newPassword.second, 'Confirmer le nouveau mot de passe', {'label_attr': {'class': 'block text-gray-700 font-semibold'}}) }}
                {{ form_widget(changePasswordForm.newPassword.second, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-400'}}) }}

                <button type="button" class="absolute right-3 top-9 text-gray-500 hover:text-gray-700 toggle-password">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 eye-icon" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 4.5c-7.333 0-11 7.5-11 7.5s3.667 7.5 11 7.5 11-7.5 11-7.5-3.667-7.5-11-7.5z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                </button>
            </div>

            <button type="submit" class="w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 transition">
                Modifier
            </button>

            {{ form_end(changePasswordForm) }}

        </div>
    </div>
{% endblock %}
