<div class="bg-white shadow-lg rounded-xl p-4 flex flex-col gap-4">
    <!-- Image de couverture -->
    <div class="w-full flex justify-center">
        <div class="w-32 h-48 overflow-hidden rounded-xl shadow-md">
            <img src="{{ asset('uploads/book_covers/' ~ book.imageName) }}"
                 alt="Image de couverture"
                 class="w-full h-full object-cover object-center">
        </div>
    </div>


    <!-- Informations du livre -->
    <div class="flex flex-col gap-2">
        <h2 class="text-xl font-bold text-gray-800 line-clamp-2">{{ book.title }}</h2>
        <p class="text-gray-600 text-sm"><span class="font-semibold">Auteur :</span> {{ book.authorName }}</p>
        <p class="text-green-700 text-lg font-semibold">{{ book.price }} €</p>
    </div>

    <!-- Actions -->
    <div class="flex flex-col gap-2 mt-auto">
        <a href="{{ path('book_show', { id: book.id }) }}"
           class="w-full bg-blue-500 text-white text-center py-2 rounded-lg hover:bg-blue-600 transition">
            Voir plus
        </a>

        <form method="POST" action="#">
            <button type="submit"
                    class="w-full bg-green-500 text-white py-2 rounded-lg hover:bg-green-600 transition">
                Ajouter au panier
            </button>
        </form>
    </div>
</div>
