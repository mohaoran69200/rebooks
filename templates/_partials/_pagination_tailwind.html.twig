<nav class="mt-4 flex justify-center">
    <ul class="inline-flex -space-x-px text-sm">
        {% if pagination.hasPreviousPage %}
            <li>
                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({(pagination.pageParameterName): pagination.previousPage})) }}"
                   class="px-3 py-2 ml-0 leading-tight text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-100 hover:text-gray-700">
                    Précédent
                </a>
            </li>
        {% endif %}

        {% for page in pagination.pagesInRange %}
            <li>
                {% if page == pagination.currentPage %}
                    <span class="px-3 py-2 leading-tight text-blue-600 bg-blue-50 border border-blue-300">{{ page }}</span>
                {% else %}
                    <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({(pagination.pageParameterName): page})) }}"
                       class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700">
                        {{ page }}
                    </a>
                {% endif %}
            </li>
        {% endfor %}

        {% if pagination.hasNextPage %}
            <li>
                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({(pagination.pageParameterName): pagination.nextPage})) }}"
                   class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-100 hover:text-gray-700">
                    Suivant
                </a>
            </li>
        {% endif %}
    </ul>
</nav>
