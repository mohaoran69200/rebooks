<header class="bg-white shadow-md">
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">
        <!-- Logo -->
        <a href="{{ path('home') }}" class="text-2xl font-bold text-blue-500">
            ReBooks
        </a>

        <!-- Barre de recherche centrée -->
        <div class="flex-1 mx-6">
            <div class="relative w-full max-w-lg mx-auto">
                <input type="text" placeholder="Rechercher..."
                       class="w-full border border-gray-300 rounded-full px-6 py-3 pr-12 focus:outline-none focus:ring
                        focus:ring-blue-200">
                <button class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-blue-500">
                    <!-- Icône de loupe (recherche) -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M21 21l-4.35-4.35m0 0A8.5 8.5 0 1010.5 19a8.5 8.5 0 006.15-2.65z"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Icônes d'actions (Compte et Panier) -->

        <div class="flex items-center space-x-6">

            <!-- Compte -->
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <div class="relative">
                    <button id="user-menu-button" class="text-gray-600 hover:text-blue-500 focus:outline-none">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="icon icon-tabler icons-tabler-outline icon-tabler-user">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/>
                            <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>
                        </svg>
                    </button>
                    <!-- Dropdown menu -->
                    <div id="user-menu" class="absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-lg
                    shadow-lg opacity-0 invisible transition-opacity duration-200">
                        <a href="{{ path('app_profile_view') }}" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
                            Mon profil</a>
                        <a href="{{ path('app_profile_edit') }}" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
                            Modifier mon compte</a>
                        <a href="{{ path('app_logout') }}" class="block px-4 py-2 text-red-600 hover:bg-gray-100">
                            Se déconnecter</a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" class="text-gray-600 hover:text-blue-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-user">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/>
                        <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>
                    </svg>
                </a>
            {% endif %}


            <!-- Panier -->
            <a href="#" class="text-gray-600 hover:text-blue-500">
                <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"
                      stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"
                      class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-cart">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6 19m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                    <path d="M17 19m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M17 17h-11v-14h-2" />
                    <path d="M6 5l14 1l-1 7h-13" />
                </svg>
            </a>
        </div>
    </div>
</header>
