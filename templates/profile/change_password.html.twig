{% extends 'base.html.twig' %}
<section class="bg-gray-100 py-10">
    <div class="max-w-4xl mx-auto bg-white rounded-lg shadow-md p-8">
        <h2 class="text-2xl font-bold mb-4">Changer le mot de passe</h2>
        {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
        <div>
            {{ form_label(form.oldPassword, 'Ancien mot de passe', {'label_attr': {'class': 'block text-gray-700'}}) }}
            {{ form_widget(form.oldPassword, {'attr': {'class': 'w-full mt-1 p-2 border rounded-md'}}) }}
        </div>
        <div>
            {{ form_label(form.newPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'block text-gray-700'}}) }}
            {{ form_widget(form.newPassword.first, {'attr': {'class': 'w-full mt-1 p-2 border rounded-md'}}) }}
        </div>
        <div>
            {{ form_label(form.newPassword.second, 'Confirmer le nouveau mot de passe', {'label_attr': {'class': 'block text-gray-700'}}) }}
            {{ form_widget(form.newPassword.second, {'attr': {'class': 'w-full mt-1 p-2 border rounded-md'}}) }}
        </div>
        <div>
            <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded-md">
                Changer le mot de passe
            </button>
            <a href="{{ path('app_profile_view') }}" class="ml-4 text-gray-600 hover:underline">
                Annuler
            </a>
        </div>
        {{ form_end(form) }}
    </div>
</section>
