{% extends 'base.html.twig' %}
{% block body %}
<section class="bg-gray-100 py-10">
    <div class="max-w-4xl mx-auto bg-white rounded-lg shadow-md p-8">
        <h1 class="text-3xl font-bold mb-4">Profil de {{ user.userName }}</h1>
        <p class="text-gray-700 mb-2"><span class="font-semibold">Prénom :</span> {{ user.firstName }}</p>
        <p class="text-gray-700 mb-6"><span class="font-semibold">Nom :</span> {{ user.lastName }}</p>

        <h2 class="text-2xl font-bold mt-6 mb-4">Ses livres en ligne :</h2>
        <ul class="list-disc list-inside space-y-2">
            {% for book in books %}
                <li class="text-gray-800">{{ book.title }}</li>
            {% else %}
                <li class="text-gray-500">Aucun livre en ligne pour le moment.</li>
            {% endfor %}
        </ul>

        <div class="mt-8 space-x-4">
            <a href="{{ path('app_profile_edit') }}" class="inline-block bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded-md">
                Modifier le profil
            </a>
            <a href="{{ path('app_profile_change_password') }}" class="inline-block bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded-md">
                Changer le mot de passe
            </a>
        </div>

        <form method="post" action="{{ path('app_profile_delete') }}" class="mt-4">
            <button type="submit" onclick="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ?')"
                    class="bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded-md">
                Supprimer le compte
            </button>
        </form>
    </div>
</section>
{% endblock %}
